{
  "name": "northstar-crm-challenge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source-identical baseline for the SOL versus Gaia CRM challenge",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:reset": "tsx scripts/db.ts reset",
    "db:seed": "tsx scripts/db.ts seed",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "check:test-suites": "node scripts/check-test-suites.mjs",
    "test:fixtures": "vitest run --config vitest.unit.config.mjs && vitest run --config vitest.integration.config.mjs",
    "test:browser": "playwright install chromium && playwright test",
    "ci": "npm run format:check && npm run check:test-suites && npm run typecheck && node scripts/db-check.mjs && npm run test && npm run test:fixtures && npm run test:browser && npm run build",
    "build": "vite build && tsc --noEmit -p tsconfig.server.json",
    "dev": "tsx src/server/index.ts",
    "start": "NODE_ENV=production tsx src/server/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.8.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
